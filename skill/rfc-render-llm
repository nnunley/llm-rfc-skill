#!/usr/bin/env bash
# rfc-render-llm — project an RFC to a token-minimal digest for LLM context.
# Usage: rfc-render-llm <rfc.md>...
# Deterministic projection keeping ONLY the normative surface: identity,
# Status/Category/Corpus, [R-]-marked requirement paragraphs, keyword
# sentences, ABNF and fsm blocks verbatim, witness tables. Everything
# discursive is dropped — Abstract, Motivation, Alternatives, References,
# Changelog, the BCP 14 boilerplate, evidence transcripts, authorship —
# and headers print only when content under them survives.
# The digest cites the full document; it never replaces it.
#
# Verify mode: rfc-render-llm --verify <rfc.md> [digest.md]
# Deterministic invariants of the projection (digest freshly generated
# when not supplied): the digest's [R-] marker set equals the source's
# kept-section marker set (no requirement lost, none invented); every
# kept-section keyword sentence survives (whitespace-normalized); every
# kept-section evidence-table row survives verbatim; only abnf/fsm
# fences appear, and every line inside them exists verbatim in the
# source; the digest never exceeds the source. Silent on success.
set -u

[ $# -ge 1 ] || { echo "usage: rfc-render-llm [--verify] <rfc.md>..." >&2; exit 2; }

if [ "${1:-}" = "--verify" ]; then
    shift
    src="${1:?usage: rfc-render-llm --verify <rfc.md> [digest.md]}"
    dig="${2:-}"
    tmpd=""
    if [ -z "$dig" ]; then
        tmpd=$(mktemp)
        "$0" "$src" > "$tmpd"
        dig="$tmpd"
    fi
    fails=0
    kept_src=$(awk '
        /^```/ { inb = !inb; next }
        inb { next }
        /^## / { sec = $0; sub(/^## /, "", sec)
                 skip = (sec == "Changelog" || sec == "Motivation" || sec == "Abstract" || sec == "Alternatives Considered" || sec == "References")
                 next }
        !skip { print }
    ' "$src")
    src_m=$(printf '%s\n' "$kept_src" | grep -o '\[R-[a-z0-9-][a-z0-9-]*\]' | sort -u)
    dig_m=$(grep -o '\[R-[a-z0-9-][a-z0-9-]*\]' "$dig" | sort -u)
    for m in $src_m; do
        printf '%s\n' "$dig_m" | grep -qF "$m" || { echo "digest missing marker: $m"; fails=1; }
    done
    for m in $dig_m; do
        printf '%s\n' "$src_m" | grep -qF "$m" || { echo "digest has marker absent from source: $m"; fails=1; }
    done
    # keyword sentences: extracted by the SAME algorithm the generator
    # uses (paragraph accumulation, sentence split, keyword match), each
    # must survive whitespace-normalized in the digest
    norm_dig=$(tr -s '[:space:]' ' ' < "$dig")
    while IFS= read -r sent; do
        [ -n "$sent" ] || continue
        s=$(printf '%s' "$sent" | tr -s '[:space:]' ' ')
        case "$norm_dig" in
            *"$s"*) ;;
            *) echo "digest missing keyword sentence: $s"; fails=1 ;;
        esac
    done <<EOF
$(awk '
        /^```/ { flushpara(); inblk = !inblk; next }
        inblk { next }
        /^# / { next }
        /^\*\*[A-Za-z-]+:\*\* / { if (!body) next }
        /^## / {
            flushpara(); body = 1
            sec = $0; sub(/^## /, "", sec)
            skip = (sec == "Changelog" || sec == "Motivation" || sec == "Abstract" || \
                    sec == "Alternatives Considered" || sec == "References")
            next
        }
        skip { next }
        /^#{3,4} / { flushpara(); next }
        /^The key words "MUST"/ { boiler = 1 }
        boiler { if ($0 == "") boiler = 0; next }
        /^<!-- *evidence:/ { flushpara(); intab = 1; next }
        intab && /^\|/ { next }
        intab && !/^\|/ { intab = 0 }
        /^$/ { flushpara(); next }
        { para = para " " $0 }
        function flushpara(   n, i, s) {
            if (para == "") return
            sub(/^[[:space:]]+/, "", para)
            n = split(para, sents, /\.([[:space:]]+|$)/)
            for (i = 1; i <= n; i++) {
                s = sents[i]
                if (s ~ /(MUST|SHALL|SHOULD|REQUIRED|RECOMMENDED|OPTIONAL|MAY([^A-Z]|$))/)
                    print s
            }
            para = ""
        }
        END { flushpara() }
    ' "$src")
EOF
    # evidence-table rows in kept sections survive verbatim
    while IFS= read -r row; do
        [ -n "$row" ] || continue
        grep -qxF "$row" "$dig" || { echo "digest missing evidence row: $row"; fails=1; }
    done <<EOF
$(awk '
        /^```/ { inblk = !inblk; next }
        inblk { next }
        /^## / {
            sec = $0; sub(/^## /, "", sec)
            skip = (sec == "Changelog" || sec == "Motivation" || sec == "Abstract" || \
                    sec == "Alternatives Considered" || sec == "References")
            next
        }
        skip { next }
        /^<!-- *evidence:/ { intab = 1; next }
        intab && /^\|/ { print; next }
        intab { intab = 0 }
    ' "$src")
EOF
    badf=$(grep -E '^```' "$dig" | grep -vE '^```$' | grep -vE '^```(abnf|fsm)( @R-[a-z0-9-]+)?$' || true)
    if [ -n "$badf" ]; then
        while IFS= read -r l; do echo "digest contains non-grammar fence: $l"; done <<< "$badf"
        fails=1
    fi
    while IFS= read -r l; do
        [ -n "$l" ] || continue
        grep -qxF "$l" "$src" || { echo "digest grammar line not in source: $l"; fails=1; }
    done <<< "$(awk '/^```/ { inb = !inb; next } inb { print }' "$dig")"
    [ "$(wc -w < "$dig")" -le "$(wc -w < "$src")" ] || { echo "digest larger than source"; fails=1; }
    [ -n "$tmpd" ] && rm -f "$tmpd"
    exit $fails
fi

for f in "$@"; do
    [ -f "$f" ] || { echo "rfc-render-llm: $f not found" >&2; exit 1; }
    awk '
        # emit content, flushing any pending section headers first
        function emit(s) {
            if (p2 != "") { print p2; p2 = "" }
            if (p3 != "") { print p3; p3 = "" }
            print s
        }

        # --- fenced blocks: keep abnf and fsm verbatim, drop the rest ---
        /^```/ {
            flushpara()
            if (inblk) { if (keepblk) print $0; inblk = 0; keepblk = 0; next }
            inblk = 1
            keepblk = (!skip && $0 ~ /^```(abnf|fsm)/)
            if (keepblk) emit($0)
            next
        }
        inblk { if (keepblk) print; next }

        # --- masthead + title (identity and state only, markup stripped) ---
        /^# /                 { print; next }
        /^\*\*(Status|Category|Corpus|Obsoletes|Updates|Superseded-By):\*\* / { if (!body) { gsub(/\*\*/, ""); print; next } }
        /^\*\*[A-Za-z-]+:\*\* / { if (!body) next }

        # --- section tracking; discursive sections dropped wholesale ---
        /^## / {
            flushpara(); body = 1
            sec = $0; sub(/^## /, "", sec)
            skip = (sec == "Changelog" || sec == "Motivation" || sec == "Abstract" || \
                    sec == "Alternatives Considered" || sec == "References")
            p2 = $0; p3 = ""
            next
        }
        skip { next }
        /^#{3,4} / { flushpara(); p3 = $0; next }

        # --- the BCP 14 boilerplate is known to the reader ---
        /^The key words "MUST"/ { boiler = 1 }
        boiler { if ($0 == "") boiler = 0; next }

        # --- witness/evidence tables survive (compact rule surfaces) ---
        /^<!-- *evidence:/ { flushpara(); emit($0); intab = 1; next }
        intab && /^\|/     { print; next }
        intab && !/^\|/    { intab = 0 }

        # --- paragraph accumulation ---
        /^$/ { flushpara(); next }
        { para = para " " $0 }

        # a marked requirement keeps its whole paragraph (the marker binds
        # to its context); elsewhere keep only BCP 14 keyword sentences
        function flushpara(   n, i, s, out) {
            if (para == "") return
            sub(/^[[:space:]]+/, "", para)
            if (para ~ /\[R-[a-z0-9-]+\]/) { emit(para); para = ""; return }
            n = split(para, sents, /\.([[:space:]]+|$)/)
            out = ""
            for (i = 1; i <= n; i++) {
                s = sents[i]
                if (s ~ /(MUST|SHALL|SHOULD|REQUIRED|RECOMMENDED|OPTIONAL|MAY([^A-Z]|$))/)
                    out = out s ". "
            }
            sub(/ $/, "", out)
            if (out != "") emit(out)
            para = ""
        }
        END { flushpara() }
    ' "$f"
done

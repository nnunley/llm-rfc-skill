#!/usr/bin/env bash
# rfc-tangle — extract embedded evidence blocks from a literate RFC.
# Usage: rfc-tangle <rfc.md> [outdir]     (default outdir: ./conformance)
# Each fenced block ```<type> @R-<slug> becomes <outdir>/<rfcbase>.<slug>.<type>
# verbatim — the block's content IS the runner's native format (a moot block
# becomes a .moot file, a transcript block a .transcript, etc.). Deterministic
# runners consume the tangled files; this tool never interprets content.
# Info-string attributes, expected-result blocks, variants, chunks, includes
# and parameter tables follow draft-ndn-snippet-attributes-00; the parsing
# lives in rfc-snippets so every tool reads fences the same way.
set -eu
[[ $# -ge 1 ]] || { echo "usage: rfc-tangle <rfc.md> [outdir]" >&2; exit 2; }
[[ -f "$1" ]] || { echo "rfc-tangle: $1 not found" >&2; exit 1; }
exec "$(cd "$(dirname "$0")" && pwd)/rfc-snippets" tangle "$1" "${2:-conformance}"

#!/usr/bin/env bash
# rfc-lint — verify RFC-style project documents.
# Usage: rfc-lint <docs/rfc/NNNN-slug.md>...   (exit 1 on any ERROR)
# Checks: identity, status vocabulary, required sections, BCP 14 keyword
# discipline, supersession linkage, published-immutability (git working tree).
set -u

ERRORS=0
WARNINGS=0
err()  { echo "ERROR   $1: $2"; ERRORS=$((ERRORS + 1)); }
warn() { echo "WARNING $1: $2"; WARNINGS=$((WARNINGS + 1)); }

# Coverage accounting: a clean result must enumerate what was exercised —
# "0 errors" alone cannot distinguish "checked and clean" from "nothing
# applied". ck() records an exercised check (with detail), na() records a
# check that did not apply to this document's state.
CK=""
NA=""
ck() { CK="${CK:+$CK }$1"; }
na() { NA="${NA:+$NA }$1"; }

REQUIRED_SECTIONS="Abstract Motivation Terminology Specification Alternatives_Considered Security_Considerations References Changelog"
VALID_STATUS="DRAFT|LAST-CALL|PUBLISHED|SUPERSEDED|WITHDRAWN|HISTORIC|POSTPONED"
VALID_CATEGORY="Standards-Track|Informational|Experimental|BCP"
BCP14_RE='\b(MUST NOT|MUST|REQUIRED|SHALL NOT|SHALL|SHOULD NOT|SHOULD|RECOMMENDED|NOT RECOMMENDED|MAY|OPTIONAL)\b'
BCP14_BOILERPLATE='BCP 14'

lint_file() {
    local f="$1"
    local base num header_num status

    CK=""; NA=""
    [[ -f "$f" ]] || { err "$f" "file not found"; return; }
    base="$(basename "$f")"

    # 1. Identity — two forms, IETF-style:
    #    draft-<author>-<slug>-NN.md : unpublished (distributed, collision-free)
    #    NNNN-slug.md                : number assigned at publication only
    local form=""
    if [[ "$base" =~ ^([0-9]{4})-[a-z0-9-]+\.md$ ]]; then
        form="numbered"
        num="${BASH_REMATCH[1]}"
        header_num="$(sed -n 's/^# RFC \([0-9]\{4\}\):.*/\1/p' "$f" | head -1)"
        if [[ -z "$header_num" ]]; then
            err "$f" "missing title line '# RFC $num: <Title>'"
        elif [[ "$header_num" != "$num" ]]; then
            err "$f" "title says RFC $header_num but filename says $num"
        fi
    elif [[ "$base" =~ ^(draft-[a-z0-9]+-[a-z0-9-]+-[0-9]{2})\.md$ ]]; then
        form="draft"
        local draft_name="${BASH_REMATCH[1]}"
        grep -q "^# $draft_name: " "$f" || \
            err "$f" "missing title line '# $draft_name: <Title>'"
    else
        err "$f" "filename must be draft-<author>-<slug>-NN.md (unpublished) or NNNN-slug.md (published)"
    fi
    ck "identity(${form:-invalid})"

    # 2. Status line and vocabulary
    status="$(sed -n 's/^\*\*Status:\*\* *//p' "$f" | head -1 | tr -d '[:space:]')"
    if [[ -z "$status" ]]; then
        err "$f" "missing '**Status:** <${VALID_STATUS//|/ | }>' line"
    elif ! [[ "$status" =~ ^(${VALID_STATUS})$ ]]; then
        err "$f" "invalid status '$status' (valid: ${VALID_STATUS//|/, })"
    fi
    ck "status(${status:-missing})"

    # 2a. Status must match the filename form: numbers exist only after
    # publication (the merge of the index entry is the serialization point)
    case "$form:$status" in
        numbered:DRAFT|numbered:LAST-CALL|numbered:WITHDRAWN|numbered:POSTPONED)
            err "$f" "numbered RFCs are published by definition — unpublished docs use draft-<author>-<slug>-NN.md" ;;
        draft:PUBLISHED|draft:SUPERSEDED|draft:HISTORIC)
            err "$f" "publishing assigns the number: rename to NNNN-slug.md and add the index entry" ;;
    esac
    if [[ -n "$form" && -n "$status" ]]; then ck "status-form"; else na "status-form"; fi

    # 2c. LAST-CALL must state its deadline (RFC 2026 §6.1.2 mandates minimum
    # review windows; here the window must at least be explicit)
    if [[ "$status" == "LAST-CALL" ]]; then
        grep -qiE "objections by [0-9]{4}-[0-9]{2}-[0-9]{2}" "$f" || \
            err "$f" "LAST-CALL requires a Changelog line 'objections by YYYY-MM-DD'"
        ck "deadline"
        # Consensus record (rfcbot-derived): consent is registered, never
        # inferred. LAST-CALL requires a reviewer table; dispositions are
        # pending, consent, or concern: <text>.
        local cons_rows cons_bad
        cons_rows=$(awk '
            /^\| *reviewer *\| *disposition *\|/ { intab = 1; next }
            intab && /^\|[ :-]*\|/ { next }
            intab && /^\|/ { print; next }
            intab { intab = 0 }
        ' "$f")
        if [[ -z "$cons_rows" ]]; then
            err "$f" "LAST-CALL requires a consensus table (| reviewer | disposition |) with the named reviewers"
            na "consensus"
        else
            cons_bad=$(awk -F'|' '
                {
                    d = $3
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", d)
                    if (d != "pending" && d != "consent" && d !~ /^concern:/)
                        print d
                }
            ' <<< "$cons_rows")
            if [[ -n "$cons_bad" ]]; then
                while IFS= read -r d; do
                    err "$f" "consensus disposition must be pending, consent, or 'concern: <text>' — got '$d'"
                done <<< "$cons_bad"
            fi
            ck "consensus($(grep -c . <<< "$cons_rows") reviewer(s))"
        fi
    else
        na "deadline"
        na "consensus"
    fi

    # 2d. Updates:/Obsoletes: must reference published RFC numbers
    local hdr val
    local any_ref=""
    for hdr in Updates Obsoletes; do
        val="$(sed -n "s/^\*\*$hdr:\*\* *//p" "$f" | head -1)"
        if [[ -n "$val" ]]; then
            any_ref=1
            if ! [[ "$val" =~ ^[0-9]{4}([[:space:]]*,[[:space:]]*[0-9]{4})*$ ]]; then
                err "$f" "$hdr must list 4-digit RFC numbers (comma-separated), got '$val'"
            fi
        fi
    done
    if [[ -n "$any_ref" ]]; then ck "ref-headers"; else na "ref-headers"; fi

    # 2b. Category line (optional; if present must use RFC 2026 vocabulary)
    local category
    category="$(sed -n 's/^\*\*Category:\*\* *//p' "$f" | head -1 | tr -d '[:space:]')"
    if [[ -n "$category" ]]; then
        [[ "$category" =~ ^(${VALID_CATEGORY})$ ]] || \
            err "$f" "invalid category '$category' (valid: ${VALID_CATEGORY//|/, })"
        ck "category($category)"
    else
        na "category"
    fi

    # 3. Required sections (## headings; underscores stand for spaces)
    local sec heading nsec=0
    for sec in $REQUIRED_SECTIONS; do
        heading="${sec//_/ }"
        if grep -qE "^## $heading$" "$f"; then nsec=$((nsec + 1)); else err "$f" "missing required section '## $heading'"; fi
    done
    ck "sections($nsec/8)"

    # 4. BCP 14 discipline
    if grep -qE "$BCP14_RE" "$f"; then
        grep -q "$BCP14_BOILERPLATE" "$f" || \
            err "$f" "uses BCP 14 keywords but Terminology lacks the BCP 14 boilerplate sentence"
        ck "bcp14"
    else
        na "bcp14"
    fi
    # Lowercase normative-looking words inside Specification are ambiguous:
    # readers cannot tell requirement from description. Flag each line.
    awk '
        /^## Specification$/ { insec = 1; next }
        /^## / { insec = 0 }
        /^```/ { infence = !infence; next }
        insec && !infence && /(^|[^A-Za-z])(must|shall|should|may|required|recommended|optional)([^A-Za-z]|$)/ {
            printf "%d:%s\n", NR, $0
        }
    ' "$f" | while IFS= read -r line; do
        warn "$f" "ambiguous lowercase normative word in Specification (line ${line%%:*}) — uppercase it if it is a requirement, reword if not"
    done
    # awk|while runs in a subshell: recount warnings for the summary
    local amb
    amb=$(awk '
        /^## Specification$/ { insec = 1; next }
        /^## / { insec = 0 }
        /^```/ { infence = !infence; next }
        insec && !infence && /(^|[^A-Za-z])(must|shall|should|may|required|recommended|optional)([^A-Za-z]|$)/ { n++ }
        END { print n + 0 }
    ' "$f")
    WARNINGS=$((WARNINGS + amb))
    ck "lowercase($amb flagged)"

    # 4b. ABNF grammar blocks (```abnf fences): validate rule-definition
    # syntax and that every referenced rule name is defined here or is an
    # RFC 5234 core rule. Duplicate definitions flagged unless incremental (=/).
    local abnf_problems
    if ! grep -q '^```abnf' "$f"; then na "abnf"; fi
    abnf_problems=$(awk '
        BEGIN {
            split("ALPHA BIT CHAR CR CRLF CTL DIGIT DQUOTE HEXDIG HTAB LF LWSP OCTET SP VCHAR WSP", c, " ")
            for (i in c) core[c[i]] = 1
        }
        /^```abnf$/ { inabnf = 1; next }
        inabnf && /^```$/ { inabnf = 0; next }
        !inabnf { next }
        /^[[:space:]]*$/ || /^[[:space:]]*;/ { next }
        /^[[:space:]]/ { next }                      # continuation line
        {
            line = $0
            sub(/[[:space:]]*;.*$/, "", line)        # strip trailing comment
            if (line !~ /^[A-Za-z][A-Za-z0-9-]*[[:space:]]*=\/?/) {
                printf "line %d: not a rule definition: %s\n", NR, $0
                next
            }
            name = line; sub(/[[:space:]]*=.*/, "", name)
            if (line ~ /=\//) { } else if (name in defined) {
                printf "line %d: duplicate definition of %s (use =/ to extend)\n", NR, name
            }
            defined[name] = 1
        }
        # second pass emulation: collect references as we go
        {
            line = $0
            sub(/[[:space:]]*;.*$/, "", line)
            sub(/^[A-Za-z][A-Za-z0-9-]*[[:space:]]*=\/?/, "", line)
            gsub(/"[^"]*"/, " ", line)               # drop literals
            gsub(/%[sib]?[0-9A-Fa-fx.\-]*/, " ", line) # drop numeric terminals
            n = split(line, toks, /[^A-Za-z0-9-]+/)
            for (i = 1; i <= n; i++)
                if (toks[i] ~ /^[A-Za-z][A-Za-z0-9-]*$/) refs[toks[i]] = NR
        }
        END {
            for (r in refs)
                if (!(r in defined) && !(r in core))
                    printf "line %d: reference to undefined rule %s\n", refs[r], r
        }
    ' "$f")
    if grep -q '^```abnf' "$f"; then ck "abnf"; fi
    if [[ -n "$abnf_problems" ]]; then
        while IFS= read -r p; do err "$f" "ABNF: $p"; done <<< "$abnf_problems"
    fi

    # 4c. Conformance pairing (literate form): [R-<slug>] requirement markers
    # are proven by evidence embedded IN THIS DOCUMENT — typed fenced blocks
    # whose info string carries the tag (```transcript @R-slug, ```moot
    # @R-slug, ...) or tables preceded by an evidence comment
    # (<!-- evidence: @R-slug -->). Pairing is bidirectional: a requirement
    # without evidence and evidence without a requirement are both errors.
    # Evidence blocks must be non-empty; rfc-tangle extracts them for the
    # type's deterministic runner.
    # Markers and evidence-comment tags are collected OUTSIDE fenced blocks
    # only — evidence content that quotes a marker (fixtures, examples) must
    # not create or satisfy an obligation. Fence-opener info strings are the
    # one in-fence source, read from the opener line itself.
    local markers tags m t prose
    prose=$(awk '/^```/ { infence = !infence; next } !infence' "$f")
    markers=$(grep -oE '\[R-[a-z0-9-]+\]' <<< "$prose" | tr -d '[]' | sort -u)
    tags=$( { grep -oE '^```[a-z-]+ @R-[a-z0-9-]+' "$f"; grep -oE '<!-- *evidence: *@R-[a-z0-9-]+' <<< "$prose"; } \
            | grep -oE '@R-[a-z0-9-]+' | tr -d '@' | sort -u )
    while IFS= read -r m; do
        [[ -z "$m" ]] && continue
        grep -qx "$m" <<< "$tags" || \
            err "$f" "requirement [$m] has no embedded evidence block tagged @$m"
    done <<< "$markers"
    while IFS= read -r t; do
        [[ -z "$t" ]] && continue
        grep -qx "$t" <<< "$markers" || \
            err "$f" "evidence tagged @$t has no [$t] requirement marker"
    done <<< "$tags"
    # Non-empty check: every tagged fence must contain at least one
    # non-blank line before its closing fence
    local hollow
    hollow=$(awk '
        /^```[a-z-]+ @R-/ { tag = $2; inblk = 1; n = 0; next }
        inblk && /^```$/ { if (n == 0) print tag; inblk = 0; next }
        inblk && NF > 0 { n++ }
    ' "$f")
    if [[ -n "$hollow" ]]; then
        while IFS= read -r t; do err "$f" "evidence block $t is empty"; done <<< "$hollow"
    fi
    if [[ -n "$markers" || -n "$tags" ]]; then
        ck "evidence($(grep -c . <<< "$markers")⇄$(grep -c . <<< "$tags"))"
    else
        na "evidence"
    fi

    # 4d. FSM blocks (```fsm fences, tagged or not): a tiny verifiable
    # state-machine notation — "initial S", "S -> T", "terminal S...",
    # ";" comments. Structural validation: single initial, every state
    # reachable from it, terminal states have no outgoing transitions,
    # no non-terminal dead ends, no duplicate transitions. Renders
    # (mermaid/d2 via rfc-fsm-render) are derived artifacts, never sources.
    local fsm_problems nfsm
    nfsm=$(grep -c '^```fsm' "$f")
    if [[ "$nfsm" -eq 0 ]]; then na "fsm"; else ck "fsm($nfsm block(s))"; fi
    fsm_problems=$(awk '
        /^```fsm/ { infsm = 1; init = ""; delete_arrays(); next }
        infsm && /^```$/ { infsm = 0; finish(); next }
        !infsm { next }
        {
            line = $0
            sub(/[[:space:]]*;.*$/, "", line)
            if (line ~ /^[[:space:]]*$/) next
            n = split(line, w, /[[:space:]]+/)
            # leading empty token from indentation
            i0 = (w[1] == "") ? 2 : 1
            if (w[i0] == "initial" && n - i0 + 1 == 2) {
                if (init != "") print "duplicate initial state"
                init = w[i0+1]; states[init] = 1; next
            }
            if (w[i0] == "terminal") {
                for (i = i0+1; i <= n; i++) { term[w[i]] = 1; states[w[i]] = 1 }
                next
            }
            if (n - i0 + 1 == 3 && w[i0+1] == "->") {
                from = w[i0]; to = w[i0+2]
                states[from] = 1; states[to] = 1
                key = from SUBSEP to
                if (key in trans) print "duplicate transition " from " -> " to
                trans[key] = 1; outdeg[from]++
                adj[from] = adj[from] " " to
                next
            }
            print "line " NR ": not an fsm statement: " $0
        }
        function delete_arrays(   k) {
            split("", states); split("", term); split("", trans)
            split("", outdeg); split("", adj); split("", seen); split("", q)
        }
        function finish(   qi, qn, j, m, a, s) {
            if (init == "") { print "missing initial state"; return }
            qn = 0; q[qn++] = init; seen[init] = 1
            for (qi = 0; qi < qn; qi++) {
                m = split(adj[q[qi]], a, " ")
                for (j = 1; j <= m; j++)
                    if (a[j] != "" && !(a[j] in seen)) { seen[a[j]] = 1; q[qn++] = a[j] }
            }
            for (s in states) if (!(s in seen)) print "state " s " unreachable from " init
            for (s in term) if (s in outdeg) print "terminal state " s " has outgoing transitions"
            for (s in states) if (!(s in term) && !(s in outdeg)) print "state " s " is a dead end (no outgoing transitions, not terminal)"
        }
        END { if (infsm) print "unclosed fsm block" }
    ' "$f")
    if [[ -n "$fsm_problems" ]]; then
        while IFS= read -r p; do err "$f" "FSM: $p"; done <<< "$fsm_problems"
    fi

    # 4e. FSM witness cross-check: when a tag has BOTH an fsm block and a
    # witness table (| from | to | allowed |), every "yes" row must be a
    # transition of the machine and every "no" row must not be.
    local fsm_witness_problems
    fsm_witness_problems=$(awk '
        /^```fsm @R-[a-z0-9-]+$/ { tag = $2; sub(/^@R-/, "", tag); infsm = 1; next }
        infsm && /^```$/ { infsm = 0; next }
        infsm {
            line = $0; sub(/[[:space:]]*;.*$/, "", line)
            n = split(line, w, /[[:space:]]+/)
            i0 = (w[1] == "") ? 2 : 1
            if (n - i0 + 1 == 3 && w[i0+1] == "->") print "T", tag, w[i0], w[i0+2]
            next
        }
        /^<!-- *evidence: *@R-[a-z0-9-]+ *-->$/ {
            wtag = $0; sub(/^<!-- *evidence: *@R-/, "", wtag); sub(/ *-->$/, "", wtag)
            intab = 1; next
        }
        intab && /^\|/ {
            line = $0; gsub(/^\||\|$/, "", line)
            n = split(line, c, /\|/)
            for (i = 1; i <= n; i++) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", c[i]) }
            if (n >= 3 && c[1] != "from" && c[1] !~ /^-+$/ && c[3] != "")
                print "W", wtag, c[1], c[2], c[3]
            next
        }
        intab { intab = 0 }
    ' "$f" | awk '
        $1 == "T" { trans[$2 SUBSEP $3 SUBSEP $4] = 1; hasfsm[$2] = 1; next }
        $1 == "W" { wt[++nw] = $2 SUBSEP $3 SUBSEP $4 SUBSEP $5 }
        END {
            for (i = 1; i <= nw; i++) {
                split(wt[i], p, SUBSEP)
                tag = p[1]; from = p[2]; to = p[3]; verdict = p[4]
                if (!(tag in hasfsm)) continue
                intrans = ((tag SUBSEP from SUBSEP to) in trans)
                if (verdict == "yes" && !intrans)
                    print "witness @R-" tag ": " from " -> " to " marked allowed but absent from the machine"
                if (verdict == "no" && intrans)
                    print "witness @R-" tag ": " from " -> " to " marked forbidden but present in the machine"
            }
        }
    ')
    if [[ -n "$fsm_witness_problems" ]]; then
        while IFS= read -r p; do err "$f" "FSM: $p"; done <<< "$fsm_witness_problems"
        ck "fsm-witnesses"
    elif grep -q '^```fsm @R-' "$f"; then
        ck "fsm-witnesses"
    else
        na "fsm-witnesses"
    fi

    # 5. Supersession linkage
    if [[ "$status" == "SUPERSEDED" ]]; then
        grep -qE '^\*\*Superseded-By:\*\* *[0-9]{4}' "$f" || \
            err "$f" "SUPERSEDED status requires '**Superseded-By:** NNNN'"
        ck "supersession"
    else
        na "supersession"
    fi

    # 6. Published RFCs are immutable: a dirty working copy is a violation
    if [[ "$status" == "PUBLISHED" ]] && command -v git >/dev/null 2>&1; then
        if git -C "$(dirname "$f")" status --porcelain -- "$base" 2>/dev/null | grep -q .; then
            err "$f" "PUBLISHED RFC has uncommitted modifications — publish a superseding RFC instead"
        fi
        ck "immutability"
    else
        na "immutability"
    fi
    echo "rfc-lint $base — checked: ${CK:-none}; n/a: ${NA:-none}"
}

[[ $# -ge 1 ]] || { echo "usage: rfc-lint <rfc.md>..." >&2; exit 2; }
for f in "$@"; do lint_file "$f"; done

echo "rfc-lint: $ERRORS error(s), $WARNINGS warning(s)"
[[ $ERRORS -eq 0 ]]

MERMAID = '''<script type="module">
import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
const dark = matchMedia("(prefers-color-scheme: dark)").matches;
mermaid.initialize({ startOnLoad: false, theme: dark ? "dark" : "neutral" });
await mermaid.run({ querySelector: "pre.mermaid" });
</script>'''

import html, re, subprocess, tempfile, os, pathlib

RFC_DIR = os.path.abspath(sys.argv[1])
OUT = os.path.abspath(sys.argv[2])
EMBED = "--embed" in sys.argv[3:]
MULTI = not EMBED and not OUT.endswith(".html")
FSM_RENDER = os.path.join(os.path.dirname(os.path.abspath(__file__)), "rfc-fsm-render")
LLM_RENDER = os.path.join(os.path.dirname(os.path.abspath(__file__)), "rfc-render-llm")

NAMES = set()       # documents in this series, by stem
def discover():
    docs = []
    for f in sorted(pathlib.Path(RFC_DIR).glob("*.md")):
        if f.name == "index.md": continue
        head = f.read_text()[:800]
        cat = (re.search(r"\*\*Category:\*\* *([A-Za-z-]+)", head) or [None, "Uncategorized"])[1]
        docs.append((f.stem, cat))
    docs.sort(key=lambda d: (0 if d[1] == "BCP" else 1 if d[0][0].isdigit() else 2, d[0]))
    return docs

def fsm_to_mermaid(src):
    with tempfile.NamedTemporaryFile("w", suffix=".fsm", delete=False) as f:
        f.write(src); path = f.name
    out = subprocess.run([FSM_RENDER, path, "mermaid"], capture_output=True, text=True).stdout
    os.unlink(path)
    return out

def doc_href(name):
    return f"{name}.html" if MULTI else f"#{name}"

def crosslink(s, self_name):
    # series documents: draft names and published NNNN-slug stems
    def dl(m):
        n = m.group(0)
        if n in NAMES and n != self_name:
            return f'<a href="{doc_href(n)}">{n}</a>'
        return n
    s = re.sub(r'\bdraft-[a-z]+-[a-z0-9-]+-\d{2}\b', dl, s)
    # internet RFC citations -> rfc-editor (series-local numbers win if present)
    def rl(m):
        num = m.group(1)
        local = next((n for n in NAMES if n.startswith(num + "-")), None)
        if local and local != self_name:
            return f'<a href="{doc_href(local)}">RFC {num}</a>'
        return f'<a href="https://www.rfc-editor.org/rfc/rfc{int(num)}">RFC {num}</a>'
    s = re.sub(r'\bRFC (\d{3,5})\b', rl, s)
    return s

def inline(s, self_name="", link=True):
    s = html.escape(s, quote=False)
    s = re.sub(r'`([^`]+)`', r'<code>\1</code>', s)
    s = re.sub(r'\*\*([^*]+)\*\*', r'<strong>\1</strong>', s)
    s = re.sub(r'\[R-([a-z0-9-]+)\]', r'<span class="rtag">[R-\1]</span>', s)
    if link:
        s = crosslink(s, self_name)
    s = re.sub(r'(?<!href=")(https?://[^\s<)]+)', r'<a href="\1">\1</a>', s)
    return s

def render_doc(name):
    text = pathlib.Path(RFC_DIR, f"{name}.md").read_text()
    lines = text.split("\n")
    out, i, in_masthead = [], 0, False
    title = name
    status = "DRAFT"
    def il(s): return inline(s, self_name=name)
    while i < len(lines):
        ln = lines[i]
        if ln.startswith("```"):
            info = ln[3:].strip()
            block = []
            i += 1
            while i < len(lines) and lines[i] != "```":
                block.append(lines[i]); i += 1
            i += 1
            body = "\n".join(block)
            tag = ""
            m = re.match(r'(\w[\w-]*)\s+(@R-[a-z0-9-]+)', info)
            btype = info.split(" ")[0] if info else "text"
            if m: btype, tag = m.group(1), m.group(2)
            if btype == "fsm":
                mer = fsm_to_mermaid(body)
                out.append(f'<figure class="diagram">{"<div class=btag>"+html.escape(tag)+"</div>" if tag else ""}<pre class="mermaid">\n{html.escape(mer)}</pre>'
                           f'<figcaption>state machine — derived from the verified <code>fsm</code> source by rfc-fsm-render</figcaption>'
                           f'<details><summary>fsm source</summary><pre class="code">{html.escape(body)}</pre></details></figure>')
            else:
                cls = "transcript" if btype == "transcript" else "code"
                out.append(f'<figure class="evblock">{"<div class=btag>"+html.escape(tag)+" <em>"+btype+"</em></div>" if tag else ""}'
                           f'<pre class="{cls} lang-{btype}">{html.escape(body)}</pre></figure>')
            continue
        if ln.startswith("<!-- evidence:"):
            t = re.search(r'@R-[a-z0-9-]+', ln)
            out.append(f'<div class="btag">{t.group(0) if t else ""} <em>table</em></div>')
            i += 1; continue
        if ln.startswith("<!--"):
            while i < len(lines) and "-->" not in lines[i]: i += 1
            i += 1; continue
        if ln.startswith("# "):
            title = ln[2:]
            out.append(f'<h1>{inline(ln[2:], self_name=name, link=False)}</h1>')
            i += 1; continue
        mm = re.match(r'\*\*([A-Za-z-]+):\*\* (.*)', ln)
        if mm and len(out) < 6:
            if not in_masthead:
                out.append('<dl class="masthead">'); in_masthead = True
            if mm.group(1) == "Status": status = mm.group(2).strip()
            out.append(f'<div><dt>{mm.group(1)}</dt><dd>{il(mm.group(2))}</dd></div>')
            i += 1
            if not re.match(r'\*\*([A-Za-z-]+):\*\* ', lines[i] if i < len(lines) else ""):
                out.append('</dl>'); in_masthead = False
            continue
        if ln.startswith("## "):
            sid = re.sub(r'[^a-z0-9]+', '-', ln[3:].lower()).strip('-')
            out.append(f'<h2 id="{name}-{sid}">{il(ln[3:])}</h2>'); i += 1; continue
        if ln.startswith("#### "):
            out.append(f'<h4>{il(ln[5:])}</h4>'); i += 1; continue
        if ln.startswith("### "):
            out.append(f'<h3>{il(ln[4:])}</h3>'); i += 1; continue
        if ln.startswith("|"):
            rows = []
            while i < len(lines) and lines[i].startswith("|"):
                if not re.match(r'^\|[\s:-]+\|', lines[i].replace("-","-")) or "---" not in lines[i]:
                    rows.append([c.strip() for c in lines[i].strip("|").split("|")])
                i += 1
            t = '<div class="tscroll"><table>'
            for ri, r in enumerate(rows):
                cell = "th" if ri == 0 else "td"
                t += "<tr>" + "".join(f"<{cell}>{il(c)}</{cell}>" for c in r) + "</tr>"
            t += "</table></div>"
            out.append(t); continue
        if ln.startswith("- "):
            items = []
            while i < len(lines) and (lines[i].startswith("- ") or lines[i].startswith("  ")):
                if lines[i].startswith("- "): items.append(lines[i][2:])
                else: items[-1] += " " + lines[i].strip()
                i += 1
            out.append("<ul>" + "".join(f"<li>{il(x)}</li>" for x in items) + "</ul>")
            continue
        if re.match(r'^\d+\. ', ln):
            items = []
            while i < len(lines) and (re.match(r'^\d+\. ', lines[i]) or lines[i].startswith("   ")):
                if re.match(r'^\d+\. ', lines[i]): items.append(re.sub(r'^\d+\. ', '', lines[i]))
                else: items[-1] += " " + lines[i].strip()
                i += 1
            out.append("<ol>" + "".join(f"<li>{il(x)}</li>" for x in items) + "</ol>")
            continue
        if ln.startswith("> "):
            q = []
            while i < len(lines) and lines[i].startswith(">"):
                q.append(lines[i].lstrip("> ")); i += 1
            out.append(f'<blockquote>{il(" ".join(q))}</blockquote>')
            continue
        if ln.strip() == "":
            i += 1; continue
        para = []
        while i < len(lines) and lines[i].strip() != "" and not re.match(r'^(#|```|\||- |\d+\. |>|<!--)', lines[i]):
            para.append(lines[i]); i += 1
        if not para:
            para = [lines[i]]; i += 1
        out.append(f"<p>{il(' '.join(para))}</p>")
    return title, status, "\n".join(out)

def nav_entry(name, cat, title, status, current=False):
    short = title.split(":", 1)[1].strip() if ":" in title else title
    cur = ' aria-current="page"' if current else ''
    return (f'<a href="{doc_href(name)}"{cur}><span class="pill p-{status}">{status}</span>'
            f'<span class="pill p-{cat}">{cat}</span><span class="navt">{html.escape(short)}</span>'
            f'<code class="navn">{name}</code></a>')

def page(title_text, nav_html, body_html, note):
    inner = (f'{STYLE}<div class="wrap">\n<nav>\n'
             f'  <div class="brand"><a href="{"index.html" if MULTI else "#"}">llm-rfc-skill</a></div>\n'
             f'  <p class="note">{note}</p>\n{nav_html}\n</nav>\n<main>\n{body_html}\n</main>\n</div>')
    if EMBED:
        return f'<title>{html.escape(title_text)}</title>' + inner
    return ("<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"
            "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
            f"<title>{html.escape(title_text)}</title>"
            + inner + MERMAID + "</body></html>")

docs = discover()
NAMES = {name for name, _ in docs}
rendered = [(name, cat) + render_doc(name) for name, cat in docs]  # (name, cat, title, status, body)
note = f"RFC series — {len(docs)} document(s), rendered from source; diagrams derived from verified fsm blocks by rfc-fsm-render."

if MULTI:
    os.makedirs(OUT, exist_ok=True)
    for name, cat, title, status, body in rendered:
        digest = subprocess.run([LLM_RENDER, os.path.join(RFC_DIR, f"{name}.md")],
                                capture_output=True, text=True).stdout
        pathlib.Path(OUT, f"{name}.llm.md").write_text(digest)
        llm_link = (f'<p class="llmlink"><a href="{name}.llm.md">LLM digest</a> — '
                    f'token-minimal normative projection ({len(digest.split())} words); '
                    f'cite the full document for anything it omits.</p>')
        nav = "\n".join(nav_entry(n, c, t, s, current=(n == name)) for n, c, t, s, _ in rendered)
        pathlib.Path(OUT, f"{name}.html").write_text(
            page(f"{name} — llm-rfc-skill", nav, f'<article id="{name}">{body}{llm_link}</article>', note))
    # index: the series index document, cross-linked, plus the nav
    nav = "\n".join(nav_entry(n, c, t, s) for n, c, t, s, _ in rendered)
    if pathlib.Path(RFC_DIR, "index.md").exists():
        _, _, idx_body = render_doc("index")
    else:
        idx_body = "<h1>RFC Index</h1>"
    pathlib.Path(OUT, "index.html").write_text(
        page("RFC Series — llm-rfc-skill", nav, f'<article id="index">{idx_body}</article>', note))
    print(f"wrote {OUT}/ ({len(rendered) + 1} pages)")
else:
    nav = "\n".join(nav_entry(n, c, t, s) for n, c, t, s, _ in rendered)
    body = "\n<hr class='docsep'>\n".join(f'<article id="{n}">{b}</article>' for n, _, _, _, b in rendered)
    pathlib.Path(OUT).write_text(page("RFC Series — llm-rfc-skill", nav, body, note))
    print(f"wrote {OUT}")

#!/usr/bin/env python3
# rfc-render-site — render an RFC series directory to HTML.
# Usage: rfc-render-site <rfc-dir> <outdir>          multi-page site (Pages):
#            index.html from index.md, one page per document, cross-linked
#        rfc-render-site <rfc-dir> <out.html> [--embed]
#            single continuous page; --embed emits a bare fragment for
#            CSP-restricted hosts with native mermaid (artifact previews)
# fsm diagrams are derived via the sibling rfc-fsm-render — never authored.

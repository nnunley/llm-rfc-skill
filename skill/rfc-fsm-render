#!/usr/bin/env bash
# rfc-fsm-render — derive display forms from a tangled .fsm file.
# Usage: rfc-fsm-render <file.fsm> {mermaid|d2}
# Renders are DERIVED artifacts: the fsm block is the verified source of
# truth; never edit a render. mermaid targets GitHub-native HTML display;
# d2 targets `d2 --ascii` box-model text (and SVG).
set -eu

[[ $# -eq 2 ]] || { echo "usage: rfc-fsm-render <file.fsm> {mermaid|d2}" >&2; exit 2; }
f="$1"; mode="$2"
[[ -f "$f" ]] || { echo "rfc-fsm-render: $f not found" >&2; exit 1; }

case "$mode" in
mermaid)
    # Mermaid state IDs reject characters like "-" that the fsm notation
    # allows (LAST-CALL). Sanitize IDs and declare display aliases.
    echo "stateDiagram-v2"
    awk '
        function sid(name,   s) { s = name; gsub(/[^A-Za-z0-9_]/, "_", s); return s }
        function note(name) { if (sid(name) != name && !(name in seen)) { seen[name] = 1; printf "    state \"%s\" as %s\n", name, sid(name) } }
        { sub(/[[:space:]]*;.*$/, "") }
        /^[[:space:]]*$/ { next }
        $1 == "initial"  { note($2); init = sid($2); next }
        $1 == "terminal" { for (i = 2; i <= NF; i++) { note($i); term[sid($i)] = 1 } next }
        $1 == "note" {
            nname = $2; sub(/:$/, "", nname); note(nname)
            text = $0
            sub(/^[[:space:]]*note[[:space:]]+[A-Za-z0-9_-]+:[[:space:]]*/, "", text)
            stnote[sid(nname)] = (sid(nname) in stnote) ? stnote[sid(nname)] "; " text : text
            next
        }
        NF == 3 && $2 == "->" { note($1); note($3); edges[++n] = sid($1) " --> " sid($3); next }
        END {
            if (init != "") printf "    [*] --> %s\n", init
            for (i = 1; i <= n; i++) printf "    %s\n", edges[i]
            for (t in term) printf "    %s --> [*]\n", t
            for (t in stnote) printf "    note right of %s: %s\n", t, stnote[t]
        }
    ' "$f"
    ;;
d2)
    awk '
        { sub(/[[:space:]]*;.*$/, "") }
        /^[[:space:]]*$/ { next }
        $1 == "initial"  { printf "start: \"\" { shape: circle; width: 20 }\nstart -> %s\n", $2; next }
        $1 == "terminal" { for (i = 2; i <= NF; i++) printf "%s.style.double-border: true\n", $i; next }
        $1 == "note" {
            nname = $2; sub(/:$/, "", nname)
            text = $0; sub(/^[[:space:]]*note[[:space:]]+[A-Za-z0-9_-]+:[[:space:]]*/, "", text)
            printf "%s.tooltip: %s\n", nname, text
            next
        }
        NF == 3 && $2 == "->" { printf "%s -> %s\n", $1, $3 }
    ' "$f"
    ;;
*)
    echo "rfc-fsm-render: unknown mode '$mode' (mermaid|d2)" >&2; exit 2
    ;;
esac

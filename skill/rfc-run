#!/usr/bin/env bash
# rfc-run — execute an RFC's evidence corpus through adapters.
#
# Corpus mode:   rfc-run <rfc.md>...
#   Tangles each document's tagged evidence blocks and dispatches every
#   file to the adapter for its type. Exit 1 if any block fails.
# Adapter mode:  rfc-run [--adapter-dir DIR] --type T <file>
#   Resolves the adapter for T and executes it on one file; the adapter's
#   exit status is the verdict (passthrough).
#
# Adapter resolution, per draft-ndn-evidence-adapters-00: the environment
# override RFC_ADAPTER_PATH (colon-separated dirs) -> series-local
# adapters/ (the --adapter-dir argument, or <rfc dir>/adapters in corpus
# mode) -> the tooling's built-in adapters/. Resolution failure for a
# typed block is a hard error, never a silent skip.
#
# Sandbox providers, per draft-ndn-sandbox-providers-00: every adapter
# invocation may be wrapped as `provider [flags] -- adapter file`.
# Selection precedence: --sandbox NAME > RFC_SANDBOX > the series profile
# file `sandbox` (corpus mode; first non-blank non-# line = name + flags) >
# the platform default from uname, falling back to the env-scrub floor.
# The reserved name `none` disables wrapping. Provider names resolve like
# adapters: RFC_SANDBOX_PATH -> series-local sandboxes/ (or --sandbox-dir)
# -> built-in sandboxes/. A selected provider that cannot be resolved is a
# hard error — never a silent bare run.
#
# Adapters own engine mechanics; providers own isolation. The built-in
# `env-scrub` provider is hygiene, not a security boundary — isolate
# foreign corpora at the deployment layer.
set -u

SKILL_DIR="$(cd "$(dirname "$0")" && pwd)"
FAILS=0

resolve_adapter() {
    local t="$1" series_dir="$2" IFS=':' d
    for d in ${RFC_ADAPTER_PATH:-}; do
        [ -n "$d" ] && [ -x "$d/$t" ] && { printf '%s' "$d/$t"; return 0; }
    done
    [ -n "$series_dir" ] && [ -x "$series_dir/$t" ] && { printf '%s' "$series_dir/$t"; return 0; }
    [ -x "$SKILL_DIR/adapters/$t" ] && { printf '%s' "$SKILL_DIR/adapters/$t"; return 0; }
    return 1
}

resolve_sandbox() {
    local t="$1" series_dir="$2" IFS=':' d
    for d in ${RFC_SANDBOX_PATH:-}; do
        [ -n "$d" ] && [ -x "$d/$t" ] && { printf '%s' "$d/$t"; return 0; }
    done
    [ -n "$series_dir" ] && [ -x "$series_dir/$t" ] && { printf '%s' "$series_dir/$t"; return 0; }
    [ -x "$SKILL_DIR/sandboxes/$t" ] && { printf '%s' "$SKILL_DIR/sandboxes/$t"; return 0; }
    return 1
}

# Isolation is platform-bound, so the last resort in the precedence chain
# is derived from uname rather than declared: a provider named in a series
# profile would make the corpus unrunnable on the other platform.
platform_default() {
    case "$(uname -s)" in
        Darwin) printf 'seatbelt' ;;
        Linux)  printf 'bwrap' ;;
        *)      return 1 ;;
    esac
}

# A default is a fallback, not a selection: unlike a named provider, an
# unresolvable one falls back to the env-scrub hygiene floor rather than
# failing, and announces it — a weaker boundary than the platform intends
# must not look identical to a contained run. Sets DEFAULT_PROVIDER and
# DOWNGRADE_NOTICE; returns nothing on stdout, since `x=$(f)` would run
# this in a subshell and lose the notice.
DEFAULT_PROVIDER=""
DOWNGRADE_NOTICE=""
DOWNGRADE_SHOWN=""
default_provider() {
    local series_dir="$1" want p
    DEFAULT_PROVIDER=""
    # Containment is not re-entrant: sandbox_apply fails inside a seatbelt,
    # and the corpus contains evidence asserting that an unwrapped run is
    # unwrapped. An explicit --sandbox still wraps; only the default defers.
    [ -z "${RFC_SANDBOX_ACTIVE:-}" ] || return 1
    if want=$(platform_default); then
        if p=$(resolve_sandbox "$want" "$series_dir"); then
            DEFAULT_PROVIDER="$p"; return 0
        fi
        DOWNGRADE_NOTICE="rfc-run: platform provider '$want' unavailable — falling back to env-scrub (hygiene only, NOT a security boundary)"
    else
        DOWNGRADE_NOTICE="rfc-run: no containment provider for $(uname -s) — falling back to env-scrub (hygiene only, NOT a security boundary)"
    fi
    if p=$(resolve_sandbox env-scrub "$series_dir"); then
        DEFAULT_PROVIDER="$p"; return 0
    fi
    return 1
}

announce_downgrade() {
    [ -n "$DOWNGRADE_NOTICE" ] && [ -z "$DOWNGRADE_SHOWN" ] || return 0
    echo "$DOWNGRADE_NOTICE" >&2
    DOWNGRADE_SHOWN=1
}

# read_profile FILE -> sets PROFILE=(name flags...); false if no effective line
read_profile() {
    local line
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue ;; esac
        read -r -a PROFILE <<< "$line"
        return 0
    done < "$1"
    return 1
}

ADAPTER_DIR=""
SANDBOX_DIR=""
SANDBOX_FLAG=""
TYPE=""
EXPECT=0
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --adapter-dir) ADAPTER_DIR="$2"; shift 2 ;;
        --sandbox-dir) SANDBOX_DIR="$2"; shift 2 ;;
        --sandbox)     SANDBOX_FLAG="$2"; shift 2 ;;
        --type)        TYPE="$2"; shift 2 ;;
        --expect)      EXPECT=1; shift ;;
        *)             ARGS+=("$1"); shift ;;
    esac
done
set -- "${ARGS[@]:-}"

# ---- adapter mode ----
if [ -n "$TYPE" ]; then
    [ $# -eq 1 ] || { echo "usage: rfc-run [--adapter-dir DIR] [--sandbox NAME] [--sandbox-dir DIR] --type T <file>" >&2; exit 2; }
    adapter=$(resolve_adapter "$TYPE" "$ADAPTER_DIR") || {
        echo "rfc-run: no adapter found for type $TYPE"
        exit 1
    }
    if [ "$SANDBOX_FLAG" != none ] && [ "${RFC_SANDBOX:-}" = none ]; then
        echo "rfc-run: the reserved name none is honored only from --sandbox"
        exit 1
    fi
    sbname="${SANDBOX_FLAG:-${RFC_SANDBOX:-}}"
    if [ -n "$sbname" ] && [ "$sbname" != none ]; then
        provider=$(resolve_sandbox "$sbname" "$SANDBOX_DIR") || {
            echo "rfc-run: no sandbox provider found for $sbname"
            exit 1
        }
        exec "$provider" -- "$adapter" "$1"
    fi
    if [ "$sbname" != none ] && default_provider "$SANDBOX_DIR"; then
        announce_downgrade
        exec "$DEFAULT_PROVIDER" -- "$adapter" "$1"
    fi
    exec "$adapter" "$1"
fi

# ---- corpus mode ----
[ $# -ge 1 ] || { echo "usage: rfc-run <rfc.md>... | rfc-run [--adapter-dir DIR] [--sandbox NAME] [--sandbox-dir DIR] --type T <file>" >&2; exit 2; }

for rfc in "$@"; do
    series_dir="$(cd "$(dirname "$rfc")" 2>/dev/null && pwd)"
    series_adapters="$series_dir/adapters"
    series_sandboxes="${SANDBOX_DIR:-$series_dir/sandboxes}"

    # sandbox selection: flag > env > series profile > platform default
    # (the reserved name `none` is honored only from the --sandbox flag —
    # a stale environment or profile cannot silently defeat the floor)
    if [ "$SANDBOX_FLAG" != none ] && [ "${RFC_SANDBOX:-}" = none ]; then
        echo "rfc-run: the reserved name none is honored only from --sandbox"
        FAILS=$((FAILS + 1))
        continue
    fi
    PROFILE=()
    sbname="${SANDBOX_FLAG:-${RFC_SANDBOX:-}}"
    if [ -z "$sbname" ] && [ -f "$series_dir/sandbox" ] && read_profile "$series_dir/sandbox"; then
        sbname="${PROFILE[0]}"
        PROFILE=("${PROFILE[@]:1}")
        if [ "$sbname" = none ]; then
            echo "rfc-run: the reserved name none is honored only from --sandbox"
            FAILS=$((FAILS + 1))
            continue
        fi
    fi
    provider=""
    if [ -n "$sbname" ] && [ "$sbname" != none ]; then
        if ! provider=$(resolve_sandbox "$sbname" "$series_sandboxes"); then
            echo "rfc-run: no sandbox provider found for $sbname"
            FAILS=$((FAILS + 1))
            continue
        fi
    elif [ "$sbname" != none ]; then
        # nothing named anywhere in the chain: fall to the platform default
        if default_provider "$series_sandboxes"; then
            provider="$DEFAULT_PROVIDER"
            announce_downgrade
        fi
    fi

    rfc_start_fails=$FAILS
    tangled=$(mktemp -d)
    "$SKILL_DIR/rfc-tangle" "$rfc" "$tangled" >/dev/null
    found=0
    for t in "$tangled"/*; do
        [ -e "$t" ] || continue
        found=1
        type="${t##*.}"
        if ! adapter=$(resolve_adapter "$type" "$series_adapters"); then
            echo "FAIL $(basename "$t") — no adapter found for type $type"
            FAILS=$((FAILS + 1))
            continue
        fi
        if [ -n "$provider" ]; then
            ok=0; "$provider" ${PROFILE[@]+"${PROFILE[@]}"} -- "$adapter" "$t" || ok=$?
        else
            ok=0; "$adapter" "$t" || ok=$?
        fi
        if [ "$ok" = 0 ]; then
            echo "PASS $(basename "$t")"
        else
            echo "FAIL $(basename "$t")"
            FAILS=$((FAILS + 1))
        fi
    done
    [ "$found" = 1 ] || echo "rfc-run: no tangled evidence in $rfc"
    rm -rf "$tangled"

    # --expect: the document declares its corpus state (**Corpus:** green|red,
    # absent = green); a stale declaration in EITHER direction is a failure.
    if [ "$EXPECT" = 1 ]; then
        declared=$(sed -n 's/^\*\*Corpus:\*\* *//p' "$rfc" | head -1)
        declared="${declared%% *}"
        declared="${declared:-green}"
        rfc_fails=$((FAILS - rfc_start_fails))
        if [ "$declared" = red ]; then
            if [ "$rfc_fails" -gt 0 ]; then
                echo "EXPECT ok $rfc — corpus red as declared"
                FAILS=$rfc_start_fails
            else
                echo "EXPECT MISMATCH $rfc — declared red but corpus is green"
                FAILS=$((FAILS + 1))
            fi
        else
            if [ "$rfc_fails" -gt 0 ]; then
                echo "EXPECT MISMATCH $rfc — declared green but corpus is red"
            else
                echo "EXPECT ok $rfc — corpus green as declared"
            fi
        fi
    fi
done

echo "rfc-run: $FAILS failing block(s)"
[ "$FAILS" -eq 0 ]

#!/usr/bin/env bash
# rfc-run — tangle an RFC's transcript evidence and replay each block in a
# fresh sandbox (the deterministic runner for the `transcript` evidence type).
# Usage: rfc-run <rfc.md>...        exit 1 if any block fails
# Sandbox per block (per the evidence conventions): cwd + HOME +
# XDG_CONFIG_HOME at /tmp/gi-rfc, GIT_CONFIG_NOSYSTEM=1, git identity set.
# Notation: '$ cmd' runs; '? N' asserts exit status (absent = 0); other
# lines are expected output, byte-exact.
set -u

SKILL_DIR="$(cd "$(dirname "$0")" && pwd)"
SANDBOX=/tmp/gi-rfc
FAILS=0

replay_block() {
    local f="$1" fails=0 expected="" last_exit=0 last_out="" line cmd want
    flush() {
        if [ "$last_out" != "$(printf '%s' "$expected")" ]; then
            echo "DIFF $(basename "$f"):"
            printf -- '--want--\n%s\n--got--\n%s\n' "$expected" "$last_out"
            fails=1
        fi
        expected=""
    }
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '$ '*) flush
                   cmd="${line#\$ }"
                   last_out="$(eval "$cmd" 2>&1)"; last_exit=$? ;;
            '? '*) flush
                   want="${line#? }"
                   [ "$last_exit" = "$want" ] || { echo "EXIT $(basename "$f"): want $want got $last_exit"; fails=1; }
                   last_exit=0 ;;
            *)     expected="${expected:+$expected
}$line" ;;
        esac
    done < "$f"
    flush
    [ "$last_exit" = 0 ] || { echo "EXIT $(basename "$f"): want 0 got $last_exit"; fails=1; }
    return $fails
}

[ $# -ge 1 ] || { echo "usage: rfc-run <rfc.md>..." >&2; exit 2; }

for rfc in "$@"; do
    tangled=$(mktemp -d)
    "$SKILL_DIR/rfc-tangle" "$rfc" "$tangled" >/dev/null
    found=0
    for t in "$tangled"/*.transcript; do
        [ -e "$t" ] || continue
        found=1
        rm -rf "$SANDBOX" && mkdir -p "$SANDBOX"
        if ( cd "$SANDBOX" && \
             export HOME="$SANDBOX" XDG_CONFIG_HOME="$SANDBOX/.config" GIT_CONFIG_NOSYSTEM=1 && \
             export PATH="$SKILL_DIR:$PATH" && \
             git config --global user.name conformance >/dev/null 2>&1 && \
             git config --global user.email conformance@rfc >/dev/null 2>&1 && \
             replay_block "$t" ); then
            echo "PASS $(basename "$t")"
        else
            echo "FAIL $(basename "$t")"
            FAILS=$((FAILS + 1))
        fi
    done
    [ "$found" = 1 ] || echo "rfc-run: no transcript evidence in $rfc"
    rm -rf "$tangled" "$SANDBOX"
done

echo "rfc-run: $FAILS failing block(s)"
[ "$FAILS" -eq 0 ]

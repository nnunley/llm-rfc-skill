#!/usr/bin/env bash
# rfc-check — the whole conformance gate, one command.
# Usage: rfc-check <rfc-dir>          full gate (the verdict of record)
#        rfc-check <rfc.md>...        spot run (advisory — no merge standing)
# Runs, in order, exactly what CI runs:
#   1. rfc-lint over every draft and published RFC   (blocking)
#   2. rfc-run over published RFCs                   (blocking)
#   3. rfc-run --expect over drafts                  (blocking — red only by declaration)
#   4. rfc-render-llm --verify over every document   (blocking)
# then prints a per-document summary table. Exit 0 iff every gate passed.
# CI workflows and make targets are thin callers of this script — the
# gate has one body, so local runs and CI cannot drift.
set -u

[ $# -ge 1 ] || { echo "usage: rfc-check <rfc-dir> | rfc-check <rfc.md>..." >&2; exit 2; }
SKILL_DIR="$(cd "$(dirname "$0")" && pwd)"
FAIL=0
SPOT=0

shopt -s nullglob
if [ $# -eq 1 ] && [ -d "$1" ]; then
    DIR="$1"
    drafts=("$DIR"/draft-*.md)
    published=("$DIR"/[0-9]*.md)
else
    # spot run: the named files only — advisory, never the verdict of record
    SPOT=1
    DIR="(spot)"
    drafts=(); published=()
    for f in "$@"; do
        [ -f "$f" ] || { echo "rfc-check: $f not found" >&2; exit 2; }
        case "$(basename "$f")" in
            draft-*) drafts+=("$f") ;;
            [0-9]*)  published+=("$f") ;;
            *)       echo "rfc-check: $f is not an RFC document name" >&2; exit 2 ;;
        esac
    done
    echo "== SPOT RUN — advisory, no merge standing (the gate of record is rfc-check <rfc-dir>)"
fi
all=(${drafts[@]+"${drafts[@]}"} ${published[@]+"${published[@]}"})
[ ${#all[@]} -gt 0 ] || { echo "rfc-check: no RFC documents in $DIR"; exit 2; }

echo "== lint (${#all[@]} document(s))"
for f in "${all[@]}"; do
    "$SKILL_DIR/rfc-lint" "$f" > /dev/null 2>&1 || { echo "FAIL lint: $f"; "$SKILL_DIR/rfc-lint" "$f" 2>&1 | grep -E "^(ERROR|WARNING)" | head -5; FAIL=1; }
done

if [ ${#published[@]} -gt 0 ]; then
    echo "== published evidence (blocking)"
    "$SKILL_DIR/rfc-run" "${published[@]}" || FAIL=1
else
    echo "== published evidence: none yet (all drafts)"
fi

if [ ${#drafts[@]} -gt 0 ]; then
    echo "== draft corpus declarations (red only by declaration)"
    "$SKILL_DIR/rfc-run" --expect "${drafts[@]}" > /dev/null 2>&1 || { echo "FAIL: a draft's corpus does not match its declaration"; "$SKILL_DIR/rfc-run" --expect "${drafts[@]}" 2>&1 | grep MISMATCH; FAIL=1; }
fi

echo "== digest invariants"
for f in "${all[@]}"; do
    "$SKILL_DIR/rfc-render-llm" --verify "$f" || { echo "FAIL digest: $f"; FAIL=1; }
done

echo ""
echo "document | lint | corpus | declared | digest"
for f in "${all[@]}"; do
    n=$(basename "$f" .md)
    "$SKILL_DIR/rfc-lint" "$f" >/dev/null 2>&1 && L="ok" || L="FAIL"
    if "$SKILL_DIR/rfc-run" "$f" >/dev/null 2>&1; then C="green"; else C="red"; fi
    d=$(sed -n 's/^\*\*Corpus:\*\* *//p' "$f" | head -1); d="${d%% *}"; d="${d:-green}"
    [ "$C" = "$d" ] && D="$d" || D="$d (STALE)"
    "$SKILL_DIR/rfc-render-llm" --verify "$f" >/dev/null 2>&1 && G="ok" || G="FAIL"
    echo "$n | $L | $C | $D | $G"
done

echo ""
tag=""
[ "$SPOT" = 1 ] && tag=" — spot run, no merge standing"
if [ "$FAIL" = 0 ]; then
    echo "rfc-check: PASS ($DIR)$tag"
else
    echo "rfc-check: FAIL ($DIR)$tag"
fi
exit "$FAIL"

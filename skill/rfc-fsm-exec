#!/usr/bin/env bash
# rfc-fsm-exec — execute a verified fsm as a process governor.
# Usage:
#   rfc-fsm-exec <file.fsm> <state>            query: guidance + permitted moves
#   rfc-fsm-exec <file.fsm> <state> <target>   guard: exit 0 legal, 1 violation
#   rfc-fsm-exec <file.fsm> <state> timeout    guard: resolve the deadline handler
# Session mode (lightweight persisted state, progressive disclosure):
#   rfc-fsm-exec <file.fsm> --state FILE            where am I / what may I do
#   rfc-fsm-exec <file.fsm> --state FILE <target>   advance; record on success
#   rfc-fsm-exec <file.fsm> --state FILE --attach "key: value"
#                                       attach evidence to the current state
# The state file is a RUN RECORD: flush-left lines are the walked path
# (a witness: line 1 must be the machine's initial state, every
# consecutive pair a declared transition); indented 'key: value' lines
# beneath a state attach evidence to it (commits, decision summaries —
# appended with --attach); lines beginning '#' are metadata (e.g. the
# machine pin '# machine: <doc> @R-<tag> @ <sha>'). The executor walks
# only the flush-left path. An absent/empty file initializes to the
# initial state. A record with an illegal path is rejected (exit 2). Only the CURRENT
# state's guidance and legal moves are ever disclosed — an agent needs no
# view of the rest of the machine.
# The machine is the spec's verified transition relation; this tool derives
# an agent's permissions in the current stage from it — guidance comes from
# the document, never from memory. Exit 2 on usage/unknown-state errors.
set -u

STATE_FILE=""
ATTACH=""
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --state)  STATE_FILE="$2"; shift 2 ;;
        --attach) ATTACH="$2"; shift 2 ;;
        *)        ARGS+=("$1"); shift ;;
    esac
done
set -- "${ARGS[@]:-}"

f="${1:-}"
[[ -n "$f" && -f "$f" ]] || { echo "rfc-fsm-exec: fsm file not found" >&2; exit 2; }

if [[ -n "$STATE_FILE" ]]; then
    [[ $# -le 2 ]] || { echo "usage: rfc-fsm-exec <file.fsm> --state FILE [target]" >&2; exit 2; }
    target="${2:-}"
    machine_init=$(awk '{ sub(/[[:space:]]*;.*$/, "") } $1 == "initial" { print $2; exit }' "$f")
    [[ -n "$machine_init" ]] || { echo "rfc-fsm-exec: machine has no initial state" >&2; exit 2; }
    if [[ ! -s "$STATE_FILE" ]] || ! grep -q '^[^#]' "$STATE_FILE"; then
        # empty file, or a token holding only metadata headers: initialize
        printf '%s\n' "$machine_init" >> "$STATE_FILE"
        echo "session initialized at $machine_init"
    fi
    # the recorded path is a witness: validate before trusting it
    if ! awk -v sf="$STATE_FILE" '
        { sub(/[[:space:]]*;.*$/, "") }
        $1 == "initial" { init = $2; next }
        NF == 3 && $2 == "->" { trans[$1 SUBSEP $3] = 1; next }
        END {
            n = 0
            while ((getline line < sf) > 0) if (line != "" && line !~ /^#/ && line !~ /^[ \t]/) path[++n] = line
            if (n == 0 || path[1] != init) { print "state file does not begin at " init; exit 1 }
            for (i = 2; i <= n; i++)
                if (!((path[i-1] SUBSEP path[i]) in trans)) {
                    print "state file records an illegal path: " path[i-1] " -> " path[i]; exit 1
                }
        }
    ' "$f"; then
        exit 2
    fi
    cur=$(awk 'NF && $0 !~ /^#/ && $0 !~ /^[ \t]/ { last = $0 } END { print last }' "$STATE_FILE")
    if [[ -n "$ATTACH" ]]; then
        [[ -z "$target" ]] || { echo "rfc-fsm-exec: --attach takes no transition target" >&2; exit 2; }
        [[ "$ATTACH" =~ ^[a-z][a-z0-9-]*:\ .+$ ]] || { echo "rfc-fsm-exec: evidence must be 'key: value'" >&2; exit 2; }
        printf '  %s\n' "$ATTACH" >> "$STATE_FILE"
        echo "attached to $cur — $ATTACH"
        exit 0
    fi
    if [[ -z "$target" ]]; then
        set -- "$f" "$cur"
    else
        set -- "$f" "$cur" "$target"
    fi
else
    [[ $# -ge 2 && $# -le 3 ]] || { echo "usage: rfc-fsm-exec <file.fsm> <state> [target] | rfc-fsm-exec <file.fsm> --state FILE [target]" >&2; exit 2; }
fi
f="$1"; cur="$2"; target="${3:-}"

out=$(awk -v cur="$cur" -v target="$target" '
    { sub(/[[:space:]]*;.*$/, "") }
    /^[[:space:]]*$/ { next }
    $1 == "initial"  { init = $2; states[$2] = 1; next }
    $1 == "terminal" { for (i = 2; i <= NF; i++) { term[$i] = 1; states[$i] = 1 } next }
    $1 == "note" {
        nname = $2; sub(/:$/, "", nname)
        text = $0
        sub(/^[[:space:]]*note[[:space:]]+[A-Za-z0-9_-]+:[[:space:]]*/, "", text)
        notes[nname] = (nname in notes) ? notes[nname] "; " text : text
        next
    }
    $1 == "deadline" && ((NF == 4 && $3 == "->") || (NF == 5 && $4 == "->")) {
        dlt[$2] = (NF == 4 ? $4 : $5)
        if (NF == 5) dlts[$2] = $3
        next
    }
    NF == 3 && $2 == "->" { states[$1] = 1; states[$3] = 1; adj[$1] = adj[$1] " " $3; next }
    END {
        if (!(cur in states)) {
            printf "rfc-fsm-exec: %s is not a state of this machine\n", cur > "/dev/stderr"
            exit 2
        }
        n = split(adj[cur], nxt, " ")
        if (target == "timeout") {
            if (!(cur in dlt)) {
                printf "VIOLATION: %s carries no deadline — timeout is undefined here\n", cur
                exit 1
            }
            printf "LEGAL: %s -> %s (timeout handler%s)\n", cur, dlt[cur], (cur in dlts ? "; deadline " dlts[cur] : "")
            if (dlt[cur] in notes) printf "entering %s: %s\n", dlt[cur], notes[dlt[cur]]
            exit 0
        }
        if (target != "") {
            for (i = 1; i <= n; i++) if (nxt[i] == target) {
                printf "LEGAL: %s -> %s\n", cur, target
                if (target in notes) printf "entering %s: %s\n", target, notes[target]
                exit 0
            }
            printf "VIOLATION: %s -> %s is not a transition of this machine\n", cur, target
            printf "permitted from %s:%s\n", cur, (adj[cur] == "" ? " (none — terminal)" : adj[cur])
            exit 1
        }
        printf "state: %s%s%s\n", cur, (cur == init ? " (initial)" : ""), ((cur in term) ? " (terminal)" : "")
        printf "guidance: %s\n", (cur in notes ? notes[cur] : "(none recorded in the machine)")
        if (cur in dlt) printf "deadline: %son timeout -> %s\n", (cur in dlts ? dlts[cur] " — " : ""), dlt[cur]
        if (cur in term) {
            print "permitted transitions: none — this state is terminal"
        } else {
            print "permitted transitions:"
            for (i = 1; i <= n; i++) {
                if (nxt[i] == "") continue
                printf "  %s -> %s%s\n", cur, nxt[i], ((nxt[i] in notes) ? "   [" notes[nxt[i]] "]" : "")
            }
        }
        print "anything not listed above is a process violation."
    }
' "$f")
rc=$?
[ -n "$out" ] && printf '%s\n' "$out"
# session mode: record a successful advance (timeout resolves to its handler)
if [[ -n "$STATE_FILE" && -n "$target" && "$rc" -eq 0 ]]; then
    resolved=$(printf '%s\n' "$out" | sed -n 's/^LEGAL: .* -> \([A-Za-z0-9_-]*\).*$/\1/p' | head -1)
    [[ -n "$resolved" ]] && printf '%s\n' "$resolved" >> "$STATE_FILE"
fi
exit "$rc"

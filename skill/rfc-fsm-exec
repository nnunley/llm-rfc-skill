#!/usr/bin/env bash
# rfc-fsm-exec — execute a verified fsm as a process governor.
# Usage:
#   rfc-fsm-exec <file.fsm> <state>            query: guidance + permitted moves
#   rfc-fsm-exec <file.fsm> <state> <target>   guard: exit 0 legal, 1 violation
#   rfc-fsm-exec <file.fsm> <state> timeout    guard: resolve the deadline handler
# Session mode (lightweight persisted state, progressive disclosure):
#   rfc-fsm-exec <file.fsm> --state FILE            where am I / what may I do
#   rfc-fsm-exec <file.fsm> --state FILE <target>   advance; record on success
#   rfc-fsm-exec <file.fsm> --state FILE <target> --why "rationale"
#                                       advance, recording branch rationale
#   rfc-fsm-exec <file.fsm> --state FILE --attach "key: value"
#                                       attach evidence to the current state
#   rfc-fsm-exec <file.fsm> --state FILE --audit
#                                       re-verify the whole ledger (see below)
# Guarded transitions (guard A -> B: key...) refuse to advance until the
# named evidence keys are attached to the CURRENT state — the machine
# withholds the next step until the work's evidence exists. On a legal
# advance inside a git repository the executor auto-attaches
# 'anchor: <HEAD sha>', lacing the run into real history. --audit
# re-verifies everything the ledger claims: the path against the machine,
# every guard retroactively satisfied, every commit:/anchor: object
# resolvable in the repository, and anchors ordered by ancestry — a
# ledger that is hard to forge without doing the work, because its
# claims point at artifacts that only exist if the work happened.
# The state file is a RUN RECORD: flush-left lines are the walked path
# (a witness: line 1 must be the machine's initial state, every
# consecutive pair a declared transition); indented 'key: value' lines
# beneath a state attach evidence to it (commits, decision summaries —
# appended with --attach); lines beginning '#' are metadata (e.g. the
# machine pin '# machine: <doc> @R-<tag> @ <sha>'). The executor walks
# only the flush-left path. An absent/empty file initializes to the
# initial state. A record with an illegal path is rejected (exit 2). Only the CURRENT
# state's guidance and legal moves are ever disclosed — an agent needs no
# view of the rest of the machine.
# The machine is the spec's verified transition relation; this tool derives
# an agent's permissions in the current stage from it — guidance comes from
# the document, never from memory. Exit 2 on usage/unknown-state errors.
set -u

STATE_FILE=""
ATTACH=""
WHY=""
AUDIT=0
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --state)  STATE_FILE="$2"; shift 2 ;;
        --attach) ATTACH="$2"; shift 2 ;;
        --why)    WHY="$2"; shift 2 ;;
        --audit)  AUDIT=1; shift ;;
        *)        ARGS+=("$1"); shift ;;
    esac
done
set -- "${ARGS[@]:-}"

f="${1:-}"
[[ -n "$f" && -f "$f" ]] || { echo "rfc-fsm-exec: fsm file not found" >&2; exit 2; }

if [[ -n "$STATE_FILE" ]]; then
    [[ $# -le 2 ]] || { echo "usage: rfc-fsm-exec <file.fsm> --state FILE [target]" >&2; exit 2; }
    target="${2:-}"
    machine_init=$(awk '{ sub(/[[:space:]]*;.*$/, "") } $1 == "initial" { print $2; exit }' "$f")
    [[ -n "$machine_init" ]] || { echo "rfc-fsm-exec: machine has no initial state" >&2; exit 2; }
    if [[ ! -s "$STATE_FILE" ]] || ! grep -q '^[^#]' "$STATE_FILE"; then
        # empty file, or a token holding only metadata headers: initialize
        printf '%s\n' "$machine_init" >> "$STATE_FILE"
        echo "session initialized at $machine_init"
    fi
    # the recorded path is a witness: validate before trusting it
    if ! awk -v sf="$STATE_FILE" '
        { sub(/[[:space:]]*;.*$/, "") }
        $1 == "initial" { init = $2; next }
        NF == 3 && $2 == "->" { trans[$1 SUBSEP $3] = 1; next }
        END {
            n = 0
            while ((getline line < sf) > 0) if (line != "" && line !~ /^#/ && line !~ /^[ \t]/) path[++n] = line
            if (n == 0 || path[1] != init) { print "state file does not begin at " init; exit 1 }
            for (i = 2; i <= n; i++)
                if (!((path[i-1] SUBSEP path[i]) in trans)) {
                    print "state file records an illegal path: " path[i-1] " -> " path[i]; exit 1
                }
        }
    ' "$f"; then
        exit 2
    fi
    cur=$(awk 'NF && $0 !~ /^#/ && $0 !~ /^[ \t]/ { last = $0 } END { print last }' "$STATE_FILE")
    # evidence keys attached to the CURRENT state (for guard checks)
    cur_keys=$(awk '
        /^[^#[:space:]]/ { split("", have); next }
        /^[ \t]+[a-z][a-z0-9-]*:/ { k = $1; sub(/:$/, "", k); have[k] = 1 }
        END { for (k in have) printf "%s ", k }
    ' "$STATE_FILE")
    if [[ "$AUDIT" = 1 ]]; then
        # re-verify everything the ledger claims (path already validated above)
        fails=0; steps=0; anchors=0; prev_anchor=""
        guard_specs=$(awk '{ sub(/[[:space:]]*;.*$/, "") }
            $1 == "guard" && $3 == "->" && $4 ~ /:$/ {
                t = $4; sub(/:$/, "", t); printf "%s %s", $2, t
                for (i = 5; i <= NF; i++) printf " %s", $i
                print ""
            }' "$f")
        in_repo=0
        git rev-parse --git-dir >/dev/null 2>&1 && in_repo=1
        state=""; keys=" "
        check_edge() { # from to keys-of-from
            local req k
            req=$(printf '%s\n' "$guard_specs" | awk -v a="$1" -v b="$2" '$1 == a && $2 == b { for (i = 3; i <= NF; i++) printf "%s ", $i }')
            for k in $req; do
                case "$3" in *" $k "*) ;; *) echo "audit: guard $1 -> $2 unmet in ledger — missing $k:"; fails=1 ;; esac
            done
        }
        while IFS= read -r line; do
            case "$line" in
                '#'*|'') ;;
                ' '*|'	'*)
                    k="${line#"${line%%[![:space:]]*}"}"; v="${k#*: }"; k="${k%%:*}"
                    keys="$keys$k "
                    if [[ "$k" = "commit" || "$k" = "anchor" ]]; then
                        if [[ "$in_repo" = 1 ]]; then
                            if ! git cat-file -e "$v^{commit}" 2>/dev/null; then
                                echo "audit: $k: $v does not resolve in this repository"; fails=1
                            elif [[ "$k" = "anchor" ]]; then
                                anchors=$((anchors + 1))
                                if [[ -n "$prev_anchor" ]] && ! git merge-base --is-ancestor "$prev_anchor" "$v" 2>/dev/null; then
                                    echo "audit: anchors out of ancestry order: $prev_anchor then $v"; fails=1
                                fi
                                prev_anchor="$v"
                            fi
                        fi
                    fi ;;
                *)  # a transition into $line: the guard binds to the state
                    # being LEFT, whose evidence has just finished accumulating
                    [[ -n "$state" ]] && check_edge "$state" "$line" "$keys"
                    state="$line"; keys=" "; steps=$((steps + 1)) ;;
            esac
        done < "$STATE_FILE"
        [[ "$in_repo" = 1 ]] || echo "audit: no repository here — git-anchored checks skipped"
        if [[ "$fails" = 0 ]]; then
            echo "audit: ok ($steps step(s), $anchors anchor(s) verified)"
            exit 0
        fi
        echo "audit: FAIL"
        exit 1
    fi
    if [[ -n "$ATTACH" ]]; then
        [[ -z "$target" ]] || { echo "rfc-fsm-exec: --attach takes no transition target" >&2; exit 2; }
        [[ "$ATTACH" =~ ^[a-z][a-z0-9-]*:\ .+$ ]] || { echo "rfc-fsm-exec: evidence must be 'key: value'" >&2; exit 2; }
        printf '  %s\n' "$ATTACH" >> "$STATE_FILE"
        echo "attached to $cur — $ATTACH"
        exit 0
    fi
    if [[ -z "$target" ]]; then
        set -- "$f" "$cur"
    else
        set -- "$f" "$cur" "$target"
    fi
else
    [[ $# -ge 2 && $# -le 3 ]] || { echo "usage: rfc-fsm-exec <file.fsm> <state> [target] | rfc-fsm-exec <file.fsm> --state FILE [target]" >&2; exit 2; }
fi
f="$1"; cur="$2"; target="${3:-}"

out=$(awk -v cur="$cur" -v target="$target" -v cur_keys="${cur_keys:-}" '
    function guard_missing(a, b,   req, m, i, miss) {
        req = greq[a SUBSEP b]
        if (req == "") return ""
        m = split(req, ks, " "); miss = ""
        for (i = 1; i <= m; i++)
            if (index(" " cur_keys " ", " " ks[i] " ") == 0) miss = miss ks[i] " "
        sub(/ $/, "", miss)
        return miss
    }
    { sub(/[[:space:]]*;.*$/, "") }
    /^[[:space:]]*$/ { next }
    $1 == "guard" && NF >= 5 && $3 == "->" && $4 ~ /:$/ {
        gt = $4; sub(/:$/, "", gt)
        req = ""
        for (i = 5; i <= NF; i++) req = req $i " "
        sub(/ $/, "", req)
        greq[$2 SUBSEP gt] = req
        next
    }
    $1 == "initial"  { init = $2; states[$2] = 1; next }
    $1 == "terminal" { for (i = 2; i <= NF; i++) { term[$i] = 1; states[$i] = 1 } next }
    $1 == "note" {
        nname = $2; sub(/:$/, "", nname)
        text = $0
        sub(/^[[:space:]]*note[[:space:]]+[A-Za-z0-9_-]+:[[:space:]]*/, "", text)
        notes[nname] = (nname in notes) ? notes[nname] "; " text : text
        next
    }
    $1 == "deadline" && ((NF == 4 && $3 == "->") || (NF == 5 && $4 == "->")) {
        dlt[$2] = (NF == 4 ? $4 : $5)
        if (NF == 5) dlts[$2] = $3
        next
    }
    NF == 3 && $2 == "->" { states[$1] = 1; states[$3] = 1; adj[$1] = adj[$1] " " $3; next }
    END {
        if (!(cur in states)) {
            printf "rfc-fsm-exec: %s is not a state of this machine\n", cur > "/dev/stderr"
            exit 2
        }
        n = split(adj[cur], nxt, " ")
        if (target == "timeout") {
            if (!(cur in dlt)) {
                printf "VIOLATION: %s carries no deadline — timeout is undefined here\n", cur
                exit 1
            }
            miss = guard_missing(cur, dlt[cur])
            if (miss != "") {
                printf "GUARD: %s -> %s requires evidence: %s — missing: %s\n", cur, dlt[cur], greq[cur SUBSEP dlt[cur]], miss
                exit 1
            }
            printf "LEGAL: %s -> %s (timeout handler%s)\n", cur, dlt[cur], (cur in dlts ? "; deadline " dlts[cur] : "")
            if (dlt[cur] in notes) printf "entering %s: %s\n", dlt[cur], notes[dlt[cur]]
            exit 0
        }
        if (target != "") {
            for (i = 1; i <= n; i++) if (nxt[i] == target) {
                miss = guard_missing(cur, target)
                if (miss != "") {
                    printf "GUARD: %s -> %s requires evidence: %s — missing: %s\n", cur, target, greq[cur SUBSEP target], miss
                    exit 1
                }
                printf "LEGAL: %s -> %s\n", cur, target
                if (target in notes) printf "entering %s: %s\n", target, notes[target]
                exit 0
            }
            printf "VIOLATION: %s -> %s is not a transition of this machine\n", cur, target
            printf "permitted from %s:%s\n", cur, (adj[cur] == "" ? " (none — terminal)" : adj[cur])
            exit 1
        }
        printf "state: %s%s%s\n", cur, (cur == init ? " (initial)" : ""), ((cur in term) ? " (terminal)" : "")
        printf "guidance: %s\n", (cur in notes ? notes[cur] : "(none recorded in the machine)")
        if (cur in dlt) printf "deadline: %son timeout -> %s\n", (cur in dlts ? dlts[cur] " — " : ""), dlt[cur]
        if (cur in term) {
            print "permitted transitions: none — this state is terminal"
        } else {
            print "permitted transitions:"
            for (i = 1; i <= n; i++) {
                if (nxt[i] == "") continue
                gtxt = ""
                if ((cur SUBSEP nxt[i]) in greq) {
                    miss = guard_missing(cur, nxt[i])
                    gtxt = (miss == "") ? "   [guard satisfied: " greq[cur SUBSEP nxt[i]] "]" : "   [guarded — missing: " miss "]"
                }
                printf "  %s -> %s%s%s\n", cur, nxt[i], gtxt, ((nxt[i] in notes) ? "   [" notes[nxt[i]] "]" : "")
            }
        }
        print "anything not listed above is a process violation."
    }
' "$f")
rc=$?
[ -n "$out" ] && printf '%s\n' "$out"
# session mode: record a successful advance (timeout resolves to its
# handler); branch rationale lands as why:, and inside a repository the
# advance is anchored to HEAD — lacing the ledger into real history
if [[ -n "$STATE_FILE" && -n "$target" && "$rc" -eq 0 ]]; then
    resolved=$(printf '%s\n' "$out" | sed -n 's/^LEGAL: .* -> \([A-Za-z0-9_-]*\).*$/\1/p' | head -1)
    if [[ -n "$resolved" ]]; then
        printf '%s\n' "$resolved" >> "$STATE_FILE"
        [[ -n "$WHY" ]] && printf '  why: %s\n' "$WHY" >> "$STATE_FILE"
        head_sha=$(git rev-parse --short=12 HEAD 2>/dev/null || true)
        [[ -n "$head_sha" ]] && printf '  anchor: %s\n' "$head_sha" >> "$STATE_FILE"
    fi
fi
exit "$rc"

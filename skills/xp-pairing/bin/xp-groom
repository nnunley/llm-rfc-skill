#!/usr/bin/env bash
# xp-groom — what drifted, what is unserved, what has aged.
# Usage: xp-groom [problem]     (default: .xp/order.problem)
set -eu
here="$(cd "$(dirname "$0")/../../.." && pwd)"
RFC_SKILL="${RFC_SKILL:-$here/skill}"
exec "$RFC_SKILL/adapters/groom" --print "${1:-.xp/order.problem}"
